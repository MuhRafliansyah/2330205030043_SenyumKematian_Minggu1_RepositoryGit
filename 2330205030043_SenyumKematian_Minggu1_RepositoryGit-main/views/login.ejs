<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Login Laundry SSE</title>
  <link rel="stylesheet" href="/assets/style.css">
</head>
<body>
<div class="container" style="max-width:460px">
  <h2>Sistem Laundry Kiloan</h2>
  <p class="muted">Aplikasi web Node.js dengan S-SDLC.</p>
  
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert"><%= error %></div>
  <% } %>

  <form method="post" action="/login">
    <label>Username</label>
    <input name="username" placeholder="admin / budi / andi" required>
    
    <label>Password</label>
    <input name="password" type="password" placeholder="admin123 / budi123 / andi123" required>
    
    <button type="submit">Login</button>
  </form>
  
  <div class="card">
    <b>Akun Testing</b><br>
    Admin: <code>admin/admin123</code><br>
    User: <code>budi/budi123</code>, <code>andi/andi123</code>
  </div>
</div>
</body>
</html>